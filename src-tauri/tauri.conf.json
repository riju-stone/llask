{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ask",
  "version": "0.1.0",
  "identifier": "com.stone.ask",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "ask",
        "transparent": true,
        "width": 600,
        "height": 100,
        "resizable": false,
        "skipTaskbar": true,
        "decorations": false,
        "contentProtected": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Arighna Chakraborty 2025",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon-192.png",
      "icons/icon-512.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NTQ1MDYxNTFCNjMxMjYKUldRbU1iWlJZVkJVcFJHT2E0N3FPR2gwbUhKYXJBaFY1UmI3czBCamY4K2VwblBPVnl3VDc1bFkK%",
      "endpoints": [
        "https://api.github.com/riju-stone/ask/ask/releases/latest"
      ],
      "windows:": {
        "installMode": "basicUi"
      }
    }
  }
}